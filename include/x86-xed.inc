mem_ok:
check slot.seg
jno segment_ok
check slot.seg>4
jyes fs_gs
emit 1,26h+((slot.seg-1)shl 3)
jump segment_ok
fs_gs:
emit 1,64h+slot.seg-5
segment_ok:
check slot.ea and 40000h
jno prefix
emit 1,67h
prefix:
check sp=2
jyes evex
check sp=1&((w shr 8)and 1Fh)=1&~(w and 8000h)&~(rx and 3)&~(req and REQ_VEX3)
jno vex3
emit 1,0C5h
emit 1,(((rx and 4)xor 4)shl 5)or(((vvvv and 0Fh)xor 0Fh)shl 3)or((w shr 14)and 4)or((w shr 13)and 3)
compute req,req and not REQ_VEX2
jump opcode
vex3:
check req and REQ_VEX2
jyes no_vex2
check sp=1
jno xop
emit 1,0C4h
compute req,req and not REQ_VEX3
jump vex_bytes
xop:
emit 1,8Fh
vex_bytes:
emit 1,(((rx and 7)xor 7)shl 5)or((w shr 8)and 1Fh)
emit 1,((w shr 8)and 80h)or(((vvvv and 0Fh)xor 0Fh)shl 3)or((w shr 14)and 4)or((w shr 13)and 3)
jump opcode
evex:
check req and(REQ_VEX2 or REQ_VEX3)
jyes no_vex
compute ll,(w shr 16)and 3
compute b,0
check w and 20000000000000h
jno no_rc
compute ll,rc
compute b,10h
no_rc:
check w and 40000000000000h
jno no_sae
compute b,10h
no_sae:
check w and 100000000000000h
jno no_nd
compute b,10h
no_nd:
check slot.kind=2&(slot.code and 7Fh)>=11&(slot.code and 7Fh)<16
jno no_bcst
compute b,10h
no_bcst:
compute m,0
check o1.code and 80h
jno no_mask
compute m,o1.mask
check m and 8&~(w and 2000000000000h)
jyes no_zeroing
no_mask:
compute m,m or((w shr 55)and 4)
compute t,(((rx and 7)shl 5)or((rx and 8)shl 1))xor 0F0h
compute n,(vvvv and 0Fh)xor 0Fh
compute d,((((rx shr 4)and 1)xor 1)shl 3)or(m and 7)
check(w shr 70)and 1
jno no_scc
compute n,0
check(w shr 71)and 1
jno dfv_ok
compute n,dfv
compute req,req and not REQ_DFV
dfv_ok:
compute d,(w shr 66)and 0Fh
no_scc:
emit 4,62h or(t or((rx and 20h)shr 2)or((w shr 8)and 7))shl 8 or(((w shr 8)and 80h)or(n shl 3)or(4 xor((rx and 40h)shr 4))or((w shr 13)and 3))shl 16 or(((m and 8)shl 4)or(ll shl 5)or b or d)shl 24
