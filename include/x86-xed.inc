full:
check p and 46007000000000h
jyes prefixes
check p and 2000000h
jno no_66
emit 1,66h
jump no_66
prefixes:
call legacy,p
no_66:
check p and 80000004000000h|reg and 98h
jno escape_byte
compute none,0
call rex,p,none,reg,none
escape_byte:
check p and 300h
jno opcode
call escape,p
opcode:
emit 1,(p and 0FFh)+(reg and 7)
suffix:
check p and 8000000000h
jno no_suffix
emit 1,(p shr 40)and 0FFh
no_suffix:
check p and 7000h
jno done
call immediate,p,imm
done:
end calminstruction
calminstruction ea_fast text&
local t,i,n,u
compute mem.ok,0
match t:n,text
jyes done
transform text
jyes done
arrange u,text
compute text,text
compute n,elementsof text
compute mem.direct,0
check n=0
jyes direct
