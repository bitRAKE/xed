macro xed.osize s,far
if(s=16&xed.mode<>16)|(s=32&xed.mode=16)
emit 1:66h
else if s=64&far&xed.mode=64
emit 1:48h
else if(s=64&xed.mode<>64)|(s=32&xed.mode=64&~far)
err 'this operand size is not available in this mode'
end if
end macro
