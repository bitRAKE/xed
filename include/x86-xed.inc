macro xed.gate_branch mn,ns
calminstruction mn? operands&
local t,k,ld
check xed.l.ns
jyes loaded
compute xed.l.ns,1
arrange ld,=xed.=load.=ns
assemble ld
loaded:
check xed.req and xed.REQ_KEY
jyes general
match t k,operands
jyes general
match[t],operands
jyes general
match t=,k,operands
jyes general
arrange t,operands
transform t,xed.rt
jyes general
arrange t,operands
transform t
jyes general
compute xed.o1.imm,+operands
compute xed.o1.kind,3
compute t,xed.o1.imm-($+2)
compute k,44
check defined operands
jno keyed
check t relativeto 0&t>=-80h&t<80h
jyes keyed
compute k,45
keyed:
compute xed.shape,k
arrange xed.key,=k#k
jump lookup
general:
match =near? t,operands
jno not_unsized
match[k],t
jyes near_default
match ld[k],t
jyes near_written
arrange k,t
transform k,xed.rt
jno not_unsized
near_written:
arrange operands,t
jump parse
near_default:
arrange operands,=word t
check xed.mode=16
jyes parse
arrange operands,=dword t
check xed.mode=32
jyes parse
arrange operands,=qword t
jump parse
not_unsized:
match =far? t,operands
jno parse
arrange operands,t
match[k],t
jyes far_default
match =dword?[k],t
jno parse
check xed.mode=16
jyes parse
emit 1,66h
arrange operands,=fword[k]
jump parse
far_default:
arrange operands,=dword t
check xed.mode=16
jyes parse
arrange operands,=fword t
check xed.mode=32
jyes parse
arrange operands,=tword t
parse:
compute xed.branch,1
call xed.parse,operands
compute xed.branch,0
lookup:
transform xed.key,xed.r.ns
jno miss
compute xed.key,xed.key+xed.vb.ns
call xed.encode
exit
miss:
check xed.req and xed.REQ_KEY
jno none
compute ld,xed.shape
arrange xed.key,=k#ld
transform xed.key,xed.r.ns
jno none
compute xed.key,xed.key+xed.vb.ns
call xed.unhonoured
exit
none:
call xed.nomatch
end calminstruction
end macro
