calminstruction vstore#% w*,reg*,vvvv*,imm*,x*
compute begin,$
compute sp,(w shr 51)and 3
compute rx,((reg and 8)shr 1)or((reg and 10h)shr 1)or(vvvv and 10h)
check slot.kind=1
jno memory
check slot.rcode and 20h
jyes high_byte
compute rx,rx or((slot.rcode and 8)shr 3)
check(slot.code and 7Fh)<11
jno rm_vector
compute rx,rx or((slot.rcode shr 2)and 20h)
jump rm_high
rm_vector:
compute rx,rx or((slot.rcode shr 6)and 2)
rm_high:
compute op,w and 0FFh
compute rr,slot.rcode
check sp=1&(w shr 80)and 1&(rx and 5)=1&((w shr 8)and 1Fh)=1&~(w and 8000h)
jno rm_kept
compute op,(w shr 72)and 0FFh
compute rr,reg
compute reg,slot.rcode and 0Fh
compute rx,(rx and not 5)or 4
