macro use16?
xed.mode=16
x86.mode=16
xed.vslot=0
xed.amode=0
end macro
macro use32?
xed.mode=32
x86.mode=32
xed.vslot=1
xed.amode=1 shl 36
end macro
macro use64?
xed.mode=64
x86.mode=64
xed.vslot=2
xed.amode=2 shl 36
end macro
macro use? names&
iterate name,names
match =none?,name
xed.f2_cpu=0
xed.f2_fpu=0
xed.f2_simd=0
xed.f2_ext=0
xed.f2_xed=0
else match =all?,name
xed.f2m.everything
else
if defined xed.f2k.name
xed.f2m.name
else if defined xed.chip.name
xed.f2_xed=xed.f2_xed or xed.chip.name
else if defined xed.isa.name
xed.f2_xed=xed.f2_xed or 1 shl xed.isa.name
else
err 'unknown setting, XED chip or ISA set: ',`name
end if
end match
end iterate
xed.isa_update
end macro
macro xed.isa_update
xed.isa=xed.f2_cpu or xed.f2_fpu or xed.f2_simd or xed.f2_ext or xed.f2_xed
if xed.isa=xed.chip.ALL
xed.gating=0
else
xed.gating=1
end if
if xed.isa and xed.tbase=xed.tbase
xed.tgate=0
else
xed.tgate=1
end if
end macro
macro xed.use_line settings*,line&
local c,f,s,e,x
c=xed.f2_cpu
f=xed.f2_fpu
s=xed.f2_simd
e=xed.f2_ext
x=xed.f2_xed
use settings
line
xed.f2_cpu=c
xed.f2_fpu=f
xed.f2_simd=s
xed.f2_ext=e
xed.f2_xed=x
xed.isa_update
end macro
calminstruction ??&line&
local request,instruction,t
match{request}instruction,line
jyes requests
assemble line
exit
requests:
compute xed.req,0
next:
match =imm8?,request
jyes imm8
match =imm32?,request
jyes imm32
match =disp8?,request
jyes disp8
match =disp32?,request
jyes disp32
match =evex?,request
jyes evex
match =vex3?,request
jyes vex3
match =vex2?,request
jyes vex2
match =nf?,request
jyes nf
match =zu?,request
jyes zu
match =dfv?==t,request
jyes dfv
match t=,request,request
jyes setting
arrange t,request
arrange request,
setting:
arrange line,=xed.=f2k.t
check defined line
jyes one_line
arrange line,=xed.=chip.t
check defined line
jyes one_line
arrange line,=xed.=isa.t
check defined line
jyes one_line
not_setting:
arrange line,{t request}instruction
assemble line
exit
one_line:
arrange line,=xed.=f2h.t
check defined line
jyes not_setting
match,request
jyes settings
arrange request,t,request
jump use_line
settings:
arrange request,t
use_line:
arrange line,=xed.=use_line<request>,instruction
assemble line
exit
imm8:
compute xed.req,xed.req or xed.REQ_IMM8
jump more
imm32:
compute xed.req,xed.req or xed.REQ_IMM32
jump more
disp8:
compute xed.req,xed.req or xed.REQ_DISP8
jump more
disp32:
compute xed.req,xed.req or xed.REQ_DISP32
jump more
evex:
compute xed.req,xed.req or xed.REQ_EVEX
jump more
vex3:
compute xed.req,xed.req or xed.REQ_VEX3
jump more
vex2:
compute xed.req,xed.req or xed.REQ_VEX2
jump more
nf:
compute xed.req,xed.req or xed.REQ_NF
jump more
zu:
compute xed.req,xed.req or xed.REQ_ZU
jump more
dfv:
call xed.requests,request
more:
match{request}instruction,instruction
jyes next
assemble instruction
check xed.req
jno done
check xed.req and(xed.REQ_IMM8 or xed.REQ_IMM32)
jyes unmet_imm
check xed.req and(xed.REQ_EVEX or xed.REQ_VEX2 or xed.REQ_VEX3)
jyes unmet_vex
check xed.req and(xed.REQ_NF or xed.REQ_ZU)
jyes unmet_apx
err '{disp8}/{disp32} cannot be honoured: no displacement of that size encodes this operand'
jump done
unmet_vex:
err '{evex}/{vex2}/{vex3} cannot be honoured: the instruction has no such encoding for these operands'
jump done
unmet_apx:
err '{nf}/{zu} cannot be honoured: the instruction has no such form for these operands'
jump done
unmet_imm:
err '{imm8}/{imm32} cannot be honoured: the instruction has no immediate of that size'
done:
compute xed.req,0
end calminstruction
iterate<name,code,byte>,lock,1,0F0h,rep,2,0F3h,repe,2,0F3h,repz,2,0F3h,repne,3,0F2h,repnz,3,0F2h
calminstruction name? line&
match,line
jyes alone
compute xed.req,xed.req or code shl 4
assemble line
check xed.req and xed.REQ_PREFIX
jno done
compute xed.req,xed.req and not xed.REQ_PREFIX
err`name bappend ' must precede an instruction of x86-xed.inc'
done:
exit
alone:
emit 1,byte
end calminstruction
end iterate
namespace xed
define o1 o1
define o2 o2
define o3 o3
define o4 o4
define o5 o5
iterate name,pre,suf,address,sreg,t,i,n,s1,s2,n1,n2,base,index,scale,cls,default,vh,rest,d,rm,sp,rx,m,ds,ll,b,op,rr,begin
define name
end iterate
iterate slot,o1,o2,o3,o4,o5
namespace slot
iterate name,kind,size,code,num,rcode,imm,ea,mod,rm,sib,dsize,disp,rip,seg,asz,rexx,mask
define name
end iterate
end namespace
calminstruction operand#% operand
start:
match[address],operand
jyes plain_memory
match pre[address],operand
jyes sized_memory
arrange t,operand
transform t,xed.rt
jno general
match:t:,t
jno general
compute t,t
check t and 40h&mode<>64
jyes needs_long_mode
compute slot.code,t shr 16
compute slot.rcode,t and 0BFh
compute slot.kind,1
exit
plain_memory:
compute slot.kind,2
compute slot.seg,0
match sreg:address,address
jyes plain_segment
compute slot.size,sizeof address
check slot.size
jyes sized_known
compute slot.code,16
jump code_ok
plain_segment:
compute slot.size,0
jump memory_segment
sized_memory:
transform pre,xed.size
jno general
match:t,pre
jno general
compute slot.size,t
compute slot.seg,0
jump memory
general:
compute slot.size,0
compute slot.seg,0
transform operand
match pre suf,operand
jno single
transform pre,xed.size
jno several
match:t,pre
jno several
compute slot.size,t
arrange operand,suf
several:
match[address],operand
jyes memory
match{t},operand
jyes rounding
match pre{t},operand
jyes decorated
match =st?(t),operand
jyes st_indexed
match pre:suf,operand
jyes far_pointer
match pre=+3,operand
jyes group
match{t}suf,operand
jyes apx_request
single:
compute slot.imm,+operand
check slot.imm eqtype 0.0
jyes float
check slot.imm relativeto 0
jyes number
check slot.imm eq 1 elementof slot.imm&1 metadataof slot.imm relativeto reg
jyes register
check 1 metadataof slot.imm relativeto reg
jno immediate
err 'a register in an expression is an address: write it in [ ]'
exit
register:
compute t,1 metadataof slot.imm-reg
check t and 3000h
jyes not_general
check t and 40h&mode<>64
jyes needs_long_mode
compute slot.code,t shr 16
compute slot.rcode,t and 0BFh
compute slot.kind,1
check slot.size
jyes sized_register
exit
sized_register:
check((t shr 8)and 0Fh)>4|slot.size=1 shl(((t shr 8)and 0Fh)-1)
jno size_mismatch
exit
st_indexed:
compute t,+t
check t relativeto 0&t>=0&t<8
jno bad_st
compute slot.code,70
check t
jyes st_i
compute slot.code,69
st_i:
compute slot.rcode,t
compute slot.kind,1
exit
bad_st:
err 'st(i) takes 0 to 7'
exit
far_pointer:
compute slot.disp,+pre
compute slot.imm,+suf
check slot.disp relativeto 0&slot.disp>=0&slot.disp<10000h
jno bad_selector
compute slot.code,82
compute slot.kind,3
exit
bad_selector:
err 'a far pointer is selector:offset, the selector a 16-bit value'
exit
apx_request:
arrange operand,suf
match =nf?,t
jyes request_nf
match =zu?,t
jyes request_zu
err 'unknown request before the operands: {nf}, {zu}'
exit
request_nf:
compute req,req or REQ_NF
jump start
request_zu:
compute req,req or REQ_ZU
jump start
group:
arrange t,pre
transform t,xed.rt
jno single
match:t:,t
jno single
compute t,t
check((t shr 8)and 0Fh)<6|((t shr 8)and 0Fh)>8|t and 3
jyes bad_group
compute slot.code,t shr 16
compute slot.rcode,t and 0BFh
compute slot.kind,1
exit
bad_group:
err 'a register group is xmm/ymm/zmm0+3, 4+3 ... 28+3'
exit
rounding:
compute slot.kind,4
compute slot.code,80
compute rc,0
match =rn?-=sae?,t
jyes rounded
compute rc,1
match =rd?-=sae?,t
jyes rounded
compute rc,2
match =ru?-=sae?,t
jyes rounded
compute rc,3
match =rz?-=sae?,t
jyes rounded
compute slot.code,81
match =sae?,t
jyes rounded
err 'unknown rounding operand: {rn-sae}, {rd-sae}, {ru-sae}, {rz-sae} or {sae}'
rounded:
exit
decorated:
compute s1,0
compute s2,0
arrange operand,pre
decoration:
match n}{suf,t
jyes decoration_one
arrange n,t
arrange suf,
decoration_one:
arrange t,suf
match =z?,n
jyes deco_z
match =1to2?,n
jyes deco_2
match =1to4?,n
jyes deco_4
match =1to8?,n
jyes deco_8
match =1to16?,n
jyes deco_16
match =1to32?,n
jyes deco_32
compute i,+n
check i eq 1 elementof i&1 metadataof i relativeto reg
jno bad_decoration
compute i,1 metadataof i-reg
check((i shr 8)and 3Fh)=9
jno bad_decoration
check i and 7
jno k0_mask
check s1 and 7
jyes bad_decoration
compute s1,s1 or(i and 7)
jump decoration_next
deco_z:
compute s1,s1 or 8
jump decoration_next
deco_2:
compute s2,11
jump decoration_next
deco_4:
compute s2,12
jump decoration_next
deco_8:
compute s2,13
jump decoration_next
deco_16:
compute s2,14
jump decoration_next
deco_32:
compute s2,15
decoration_next:
match,t
jno decoration
check s1=8
jyes z_alone
compute slot.mask,s1
match pre suf,operand
jno deco_unsized
transform pre,xed.size
jno deco_unsized
match:i,pre
jno deco_unsized
compute slot.size,i
arrange operand,suf
deco_unsized:
match[address],operand
jyes deco_memory
check s2
jyes bcst_register
arrange t,operand
transform t,xed.rt
jno bad_decoration
match:t:,t
jno bad_decoration
compute t,t
check t and 40h&mode<>64
jyes needs_long_mode
compute slot.code,(t shr 16)or 80h
compute slot.rcode,t and 0BFh
compute slot.kind,1
exit
deco_memory:
compute slot.size,slot.size or s2 shl 20
check s1
jno memory
compute slot.size,slot.size or 10000h
jump memory
bad_decoration:
err 'invalid decoration: {k1}-{k7}, {z} after a mask, {1to2}-{1to32} on memory'
exit
k0_mask:
err 'k0 is not a mask: {k1}-{k7}'
exit
z_alone:
err '{z} needs a mask: {k1}{z}'
exit
bcst_register:
err 'a broadcast {1toN} decorates memory'
exit
not_general:
err 'segment and instruction-pointer registers are not operands of this instruction'
exit
size_mismatch:
err 'operand size does not match the register'
exit
needs_long_mode:
err '64-bit registers, r8-r15 and spl/bpl/sil/dil need use64'
exit
immediate:
compute slot.kind,3
check branch
jyes target
check slot.imm relativeto 0
jno b42
bands:
check slot.imm=1
jyes b43
check slot.imm>=-80h&slot.imm<80h
jyes b32
check slot.imm>=80h&slot.imm<100h
jyes b33
check slot.imm>=0FF80h&slot.imm<10000h
jyes b34
check slot.imm>=-8000h&slot.imm<10000h
jyes b35
check slot.imm>=0FFFFFF80h&slot.imm<100000000h
jyes b36
check slot.imm>=-80000000h&slot.imm<80000000h
jyes b37
check slot.imm>=0&slot.imm<100000000h
jyes b38
check slot.imm>=0FFFFFFFFFFFFFF80h&slot.imm<10000000000000000h
jyes b39
check slot.imm>=0FFFFFFFF80000000h&slot.imm<10000000000000000h
jyes b40
check slot.imm>=-8000000000000000h&slot.imm<10000000000000000h
jyes b41
err 'value out of range'
exit
b42:
compute slot.code,42
exit
b43:
compute slot.code,43
exit
b32:
compute slot.code,32
exit
b33:
compute slot.code,33
exit
b34:
compute slot.code,34
exit
b35:
compute slot.code,35
exit
b36:
compute slot.code,36
exit
b37:
compute slot.code,37
exit
b38:
compute slot.code,38
exit
b39:
compute slot.code,39
exit
b40:
compute slot.code,40
exit
b41:
compute slot.code,41
exit
float:
compute t,4
check %=1
jyes float_mode
check(o1.kind=1&(o1.code=4|o1.code=8))|(o1.kind=2&o1.size=8)
jno float_bits
compute t,8
jump float_bits
float_mode:
check mode=64
jno float_bits
compute t,8
float_bits:
asm virtual at 0
asm emit t:slot.imm
asm load slot.imm:t from 0
asm end virtual
number:
compute slot.kind,3
check branch
jno bands
jump target
band:
exit
target:
compute t,slot.imm-($+2)
compute slot.code,47
check slot.size=-2
jyes band
compute slot.code,44
check defined operand
jno not_short
check t relativeto 0&t>=-80h&t<80h
jyes not_short
compute slot.code,45
not_short:
check slot.size=-1
jno band
compute slot.code,46
check t relativeto 0&t>=-80h&t<80h
jyes band
err 'short jump out of range'
exit
memory:
compute slot.kind,2
match sreg:address,address
jno no_segment
memory_segment:
compute t,+sreg
check t eq 1 elementof t&1 metadataof t relativeto reg
jno bad_segment
compute t,((1 metadataof t-reg)and 0FFFFh)-2000h
check t>=0&t<6
jno bad_segment
compute slot.seg,t+1
no_segment:
check slot.size
jyes sized
compute slot.size,sizeof address
sized:
compute slot.code,16
check slot.size
jno code_ok
sized_known:
compute slot.code,31
check slot.size=1|slot.size=2|slot.size=4|slot.size=8|slot.size=16|slot.size=32|slot.size=64
jno odd_size
compute slot.code,17+bsf slot.size
code_ok:
compute address,address
compute n,elementsof address
check n=1&1 metadataof address relativeto reg
jno not_one
compute t,((1 metadataof address-reg)and 3FFFh)or(1 scaleof address)shl 14 or amode
jump ea_lookup
not_one:
check n=2&1 metadataof address relativeto reg&2 metadataof address relativeto reg
jno not_two
compute t,((1 metadataof address-reg)and 3FFFh)or(1 scaleof address)shl 14 or(((2 metadataof address-reg)and 3FFFh)or(2 scaleof address)shl 14)shl 18 or amode
jump ea_lookup
not_two:
check n=0
jyes direct
jump slow_terms
table_miss:
compute n1,1 metadataof address-reg
compute s1,1 scaleof address
check n=1
jyes registers
compute n2,2 metadataof address-reg
compute s2,2 scaleof address
jump registers
ea_lookup:
compute slot.disp,0 scaleof address
compute i,t
arrange t,=a#t
transform t,xed.at
jno table_miss
check req and 0Ch
jyes ea_request
check slot.disp relativeto 0
jno disp_wide
check slot.disp=0
jyes disp_zero
check slot.disp>=-80h&slot.disp<80h
jyes disp_byte
compute i,(i shr 8)and 0Fh
check(i=3&slot.disp>=0FFFFFF80h&slot.disp<100000000h)|(i=2&slot.disp>=0FF80h&slot.disp<10000h)
jyes disp_byte
disp_wide:
compute n,2
jump ea_segment
disp_zero:
compute n,0
jump ea_segment
disp_byte:
compute n,1
jump ea_segment
ea_request:
compute i,(i shr 8)and 0Fh
compute n,4
check req and REQ_DISP32
compute req,req and not 0Ch
jyes ea_segment
compute n,3
check slot.disp relativeto 0&((slot.disp>=-80h&slot.disp<80h)|(i=3&slot.disp>=0FFFFFF80h&slot.disp<100000000h)|(i=2&slot.disp>=0FF80h&slot.disp<10000h))
jyes ea_segment
err '{disp8} cannot be honoured: the displacement does not fit a byte'
exit
ea_segment:
check slot.seg
jyes ea_segment_class
compute i,(t*20+n*4)shl 3
load t,addr:i,8
check t
jno ea_none
compute slot.ea,t
exit
ea_segment_class:
compute i,3
check mode=64
jyes ea_long
check slot.seg=4
jno ea_ss
compute i,1
jump ea_load
ea_ss:
check slot.seg=3
jno ea_load
compute i,2
jump ea_load
ea_long:
check slot.seg>4
jyes ea_load
compute i,0
ea_load:
compute i,(t*20+n*4+i)shl 3
load t,addr:i,8
check t
jno ea_none
compute slot.ea,t
check t and 200000000h
jyes ea_done
compute slot.seg,0
jump ea_done
ea_none:
err '{disp8}/{disp32} cannot be honoured for this address'
exit
ea_done:
exit
slow_terms:
compute slot.disp,address
compute n,0
compute i,1
terms:
check i>elementsof address
jyes terms_done
check i metadataof address relativeto reg
jno next_term
compute n,n+1
compute slot.disp,slot.disp-(i elementof address)*(i scaleof address)
check n=1
jno second
compute n1,i metadataof address-reg
compute s1,i scaleof address
jump next_term
second:
check n=2
jno too_many
compute n2,i metadataof address-reg
compute s2,i scaleof address
next_term:
compute i,i+1
jump terms
terms_done:
check n
jyes registers
direct:
compute slot.rip,0
compute slot.rexx,0
compute slot.sib,-1
compute slot.asz,0
compute slot.disp,address
compute slot.imm,address
compute slot.mod,0
compute slot.num,0
compute vh,0
compute n,0
check slot.code>=16&slot.code<=20
jno direct_class
compute n,32
direct_class:
compute slot.code,slot.code+n
check mode=64
jyes direct_64
check mode=16
jyes direct_16
compute slot.rm,5
compute slot.dsize,4
jump direct_segment
direct_16:
check slot.disp relativeto 0&slot.disp>=0&slot.disp<10000h
jno direct_16_wide
compute slot.rm,6
compute slot.dsize,2
jump direct_segment
direct_16_wide:
compute slot.code,slot.code-n
compute slot.asz,1
compute slot.rm,5
compute slot.dsize,4
jump direct_segment
direct_64:
check slot.seg>4
jyes absolute_64
compute slot.code,slot.code-n
compute slot.rm,5
compute slot.dsize,4
compute slot.rip,1
jump direct_segment
absolute_64:
compute slot.rm,4
compute slot.sib,25h
compute slot.dsize,4
check slot.disp relativeto 0
jno direct_segment
check slot.disp>=0&slot.disp<80000000h
jyes direct_segment
check slot.disp>=80000000h&slot.disp<100000000h
jno absolute_signed
compute slot.asz,1
jump direct_segment
absolute_signed:
check slot.disp>=0FFFFFFFF80000000h&slot.disp<10000000000000000h
jno absolute_wide
compute slot.code,slot.code-n
compute slot.disp,slot.disp-10000000000000000h
jump direct_segment
absolute_wide:
check n
jno beyond_32
compute slot.code,slot.code+8
direct_segment:
check slot.seg=4|(mode=64&slot.seg<=4)
jno direct_done
compute slot.seg,0
direct_done:
compute mseg,slot.seg
jump address_done
registers:
compute slot.rip,0
compute slot.rexx,0
compute slot.sib,-1
compute slot.asz,0
compute vh,0
compute cls,(n1 shr 8)and 0FFh
check n=2
jno one_register
check cls=(n2 shr 8)and 0FFh
jyes one_register
check((n2 shr 8)and 0FFh)>=6&((n2 shr 8)and 0FFh)<=8
jyes vsib
check cls>=6&cls<=8
jno mixed
compute i,n1
compute n1,n2
compute n2,i
compute i,s1
compute s1,s2
compute s2,i
compute cls,(n1 shr 8)and 0FFh
jump vsib
vsib_alone:
compute n2,n1
compute s2,s1
compute s1,1
compute base,-1
check s2=1|s2=2|s2=4|s2=8
jno bad_scale
jump vsib_index
vsib:
check s1=1&(s2=1|s2=2|s2=4|s2=8)
jno bad_scale
check cls=3|cls=4
jno invalid
check cls=4&mode<>64
jyes needs_long_mode
compute slot.asz,0
check cls=3&mode<>32
jno vsib_base
compute slot.asz,1
vsib_base:
compute base,(n1 and 0Fh)or((n1 shr 3)and 10h)
vsib_index:
compute slot.code,(slot.code and 80h)or(71+((n2 shr 8)and 0Fh))
compute index,n2 and 0Fh
compute scale,s2
compute vh,(n2 shr 7)and 1
compute slot.rexx,(n2 shr 3)and 1
jump index_ok
one_register:
check cls>=6&cls<=8
jyes vsib_alone
check cls<2|cls>14h|(cls>4&cls<13h)
jyes invalid
check n1 and 40h&mode<>64
jyes needs_long_mode
compute n1,(n1 and 0Fh)or((n1 shr 3)and 10h)
check cls>4
jyes ip_relative
check cls=2
jyes address_16
check(cls=3&mode<>32)|(cls=4&mode<>64)
jno asz_ok
check cls=4
jyes needs_long_mode
compute slot.asz,1
asz_ok:
compute base,-1
compute index,-1
compute scale,1
check n=2
jyes two_registers
check s1=1
jyes base_only
check s1=2|s1=4|s1=8
jyes index_only
check(s1=3|s1=5|s1=9)&n1<>4
jno bad_scale
compute base,n1
compute index,n1
compute scale,s1-1
jump choose_mod
base_only:
compute base,n1
jump choose_mod
index_only:
compute index,n1
compute scale,s1
check s1=2&n1<>4
jno choose_mod
compute base,n1
compute scale,1
jump choose_mod
two_registers:
compute n2,(n2 and 0Fh)or((n2 shr 3)and 10h)
check s1=1&(s2=1|s2=2|s2=4|s2=8)
jyes base_first
check s2=1&(s1=2|s1=4|s1=8)
jno bad_scale
compute base,n2
compute index,n1
compute scale,s1
jump choose_mod
base_first:
compute base,n1
compute index,n2
compute scale,s2
check index=4&scale=1
jyes swap
check scale=1&(base and 7)=5&(index and 7)<>5&mode=64&slot.disp relativeto 0&slot.disp=0
jno choose_mod
swap:
compute base,n2
compute index,n1
choose_mod:
check index=4
jyes bad_index
check index<0
jyes index_ok
compute slot.rexx,(index shr 3)and 3
index_ok:
check base<0
jno with_base
compute slot.mod,0
compute slot.rm,4
compute slot.sib,((bsf scale)shl 6)+((index and 7)shl 3)+5
compute slot.dsize,4
jump default_ds
with_base:
compute slot.dsize,4
check slot.disp relativeto 0
jno mod_ready
check req and REQ_DISP32
jyes mod_ready
check slot.disp=0&(base and 7)<>5&~(req and REQ_DISP8)
jno try_disp8
compute slot.dsize,0
jump mod_ready
try_disp8:
check(slot.disp>=-80h&slot.disp<80h)|(cls=3&slot.disp>=0FFFFFF80h&slot.disp<100000000h)
jno mod_ready
compute slot.dsize,1
mod_ready:
compute slot.mod,0
check slot.dsize=1
jno mod_2
compute slot.mod,1
mod_2:
check slot.dsize=4
jno mod_set
compute slot.mod,2
mod_set:
check index<0&(base and 7)<>4
jno with_sib
compute slot.rm,base and 7
jump rex_b
with_sib:
compute slot.rm,4
check index<0
jno sib_index
compute index,4
sib_index:
compute slot.sib,((bsf scale)shl 6)+((index and 7)shl 3)+(base and 7)
rex_b:
compute slot.num,base
check base=4|base=5
jno default_ds
default_ss:
compute default,3
jump segment
default_ds:
compute default,4
check base<0
jno segment
compute slot.num,0
segment:
check slot.seg=default|(mode=64&slot.seg<=4)
jno address_done
compute slot.seg,0
jump address_done
address_16:
check mode=64
jyes no_16_in_64
compute vh,2
check mode=32
jno asz16_ok
compute slot.asz,1
asz16_ok:
check s1=1
jno bad_16
compute default,4
check n=2
jyes pair16
check n1=3
jyes bx16
check n1=5
jyes bp16
check n1=6|n1=7
jno bad_16
compute slot.rm,n1-2
jump disp16
bx16:
compute slot.rm,7
jump disp16
bp16:
compute slot.rm,6
compute default,3
jump disp16
pair16:
compute n2,n2 and 0Fh
check s2=1
jno bad_16
check n1>n2
jno ordered16
compute i,n1
compute n1,n2
compute n2,i
ordered16:
check(n1=3|n1=5)&(n2=6|n2=7)
jno bad_16
compute slot.rm,n1-3+n2-6
check n1=5
jno disp16
compute default,3
disp16:
compute slot.num,0
compute slot.dsize,2
check slot.disp relativeto 0
jno mod16
check req and REQ_DISP32
jyes no_disp32_16
check slot.disp=0&slot.rm<>6&~(req and REQ_DISP8)
jno disp16_8
compute slot.dsize,0
jump mod16
disp16_8:
check(slot.disp>=-80h&slot.disp<80h)|(slot.disp>=0FF80h&slot.disp<10000h)
jno mod16
compute slot.dsize,1
mod16:
compute slot.mod,slot.dsize
check slot.dsize=0
jyes segment
check slot.dsize=1
jyes segment
compute slot.mod,2
jump segment
ip_relative:
check n=1&s1=1
jno invalid
check mode=64
jno no_rip
check cls=13h
jno rip_ok
compute slot.asz,1
rip_ok:
compute slot.mod,0
compute slot.rm,5
compute slot.dsize,4
compute slot.num,0
check slot.seg<=4
jno address_done
compute slot.seg,0
odd_size:
compute t,slot.size
compute slot.size,t and 0FFFFh
compute slot.code,16
check slot.size
jno odd_class
compute slot.code,31
check slot.size=1|slot.size=2|slot.size=4|slot.size=8|slot.size=16|slot.size=32|slot.size=64
jno odd_80
compute slot.code,17+bsf slot.size
jump odd_class
odd_80:
check slot.size=10
jno odd_48
compute slot.code,75
jump odd_class
odd_48:
check slot.size=6
jno odd_class
compute slot.code,76
odd_class:
check t shr 20
jno odd_mask
compute slot.code,t shr 20
odd_mask:
check t and 10000h
jno code_ok
compute slot.code,slot.code or 80h
jump code_ok
address_done:
check(req and REQ_DISP8)&slot.dsize<>1
jyes unmet_disp8
compute slot.ea,slot.rm or(slot.num and 8)or(slot.rexx and 1)shl 17 or slot.asz shl 18 or(vh and 1)shl 38 or(vh and 2)shl 36 or(req and 0Ch)shl 33 or(slot.num and 10h)shl 35 or(slot.rexx and 2)shl 39 or slot.mod shl 28 or slot.dsize shl 30 or slot.rip shl 41
compute req,req and not 0Ch
check slot.sib>=0
jno ea_done
compute slot.ea,slot.ea or slot.sib shl 8 or 10000h
exit
unmet_disp8:
err '{disp8} cannot be honoured for this address'
exit
no_disp32_16:
err '{disp32} needs 32-bit addressing: write [dword ...]'
exit
bad_segment:
err 'invalid segment prefix'
exit
too_many:
err 'an address has at most two registers'
exit
mixed:
err 'address registers must be of one size'
exit
bad_scale:
err 'scale must be 1, 2, 4 or 8'
exit
bad_index:
err 'esp/rsp cannot be an index register'
exit
no_16_in_64:
err '16-bit addressing is not available in long mode'
exit
bad_16:
err '16-bit addresses are [bx|bp + si|di + disp]'
exit
no_rip:
err 'rip-relative addressing needs use64'
exit
beyond_32:
err 'an absolute address beyond 32 bits is only for mov with the accumulator'
exit
invalid:
err 'invalid address'
end calminstruction
end iterate
calminstruction parse operands&
local a,b,kv
match{a}b,operands
jyes lead
split:
match a=,b,operands
jyes two
match,operands
jyes none
call operand1,operands
compute shape,o1.code
jump keyed
none:
compute shape,0
jump keyed
two:
call operand1,a
match a=,b,b
jyes three
call operand2,b
compute shape,o1.code or o2.code shl 8
jump keyed
three:
call operand2,a
match a=,b,b
jyes four
call operand3,b
compute shape,o1.code or o2.code shl 8 or o3.code shl 16
jump keyed
four:
call operand3,a
match a=,b,b
jyes five
call operand4,b
compute shape,o1.code or o2.code shl 8 or o3.code shl 16 or o4.code shl 24
jump keyed
five:
call operand4,a
match a=,b,b
jyes too_many
call operand5,b
compute shape,o1.code or o2.code shl 8 or o3.code shl 16 or o4.code shl 24 or o5.code shl 32
keyed:
compute kv,shape or((req and 3)+((req shr 4)and 3)*3+((req shr 6)and 0Fh)*12)shl 40
arrange key,=k#kv
exit
too_many:
err 'too many operands'
exit
lead:
call requests,a
arrange operands,b
match=,b,operands
jno more
arrange operands,b
more:
match{a}b,operands
jyes lead
jump split
end calminstruction
calminstruction requests request
local t,rest
match =nf?,request
jyes nf
match =zu?,request
jyes zu
match =dfv?==rest,request
jyes dfv_list
match =dfv?==,request
jyes dfv_none
err 'unknown request before the operands: {nf}, {zu}, {dfv=...}'
exit
nf:
compute req,req or REQ_NF
exit
zu:
compute req,req or REQ_ZU
exit
dfv_none:
arrange rest,
dfv_list:
compute req,req or REQ_DFV
compute dfv,0
next:
match,rest
jyes done
match t=,rest,rest
jyes flag
arrange t,rest
arrange rest,
flag:
match =of?,t
jyes of
match =sf?,t
jyes sf
match =zf?,t
jyes zf
match =cf?,t
jyes cf
err '{dfv=} takes of, sf, zf, cf'
exit
of:
compute dfv,dfv or 8
jump next
sf:
compute dfv,dfv or 4
jump next
zf:
compute dfv,dfv or 2
jump next
cf:
compute dfv,dfv or 1
jump next
done:
end calminstruction
calminstruction nomatch
check(shape and 7Fh)=16|((shape shr 8)and 7Fh)=16|((shape shr 16)and 7Fh)=16|((shape shr 24)and 7Fh)=16
jyes size
check req and 3
jyes request
check(shape and 0FFh)>=32|((shape shr 8)and 0FFh)>=32|((shape shr 16)and 0FFh)>=32
jyes value
err 'invalid combination of operands'
exit
value:
err 'invalid combination of operands, or the value is out of range for this instruction'
exit
size:
err 'operand size not specified'
exit
request:
err '{imm8}/{imm32} cannot be honoured: no form of this instruction has that immediate'
end calminstruction
calminstruction legacy p*
check p and 40000000000000h
jno no_wait
emit 1,9Bh
no_wait:
check p and 4000000000000h&mseg
jno no_seg
check mseg>4
jyes fs_gs
emit 1,26h+((mseg-1)shl 3)
jump no_seg
fs_gs:
emit 1,64h+mseg-5
no_seg:
check p and 2000000000000h
jno no_67
emit 1,67h
no_67:
check p and 4000000000h
jno no_lock
emit 1,0F0h
no_lock:
check p and 2000000h
jno no_66
emit 1,66h
no_66:
check p and 1000000000h
jno no_f2
emit 1,0F2h
no_f2:
check p and 2000000000h
jno no_f3
emit 1,0F3h
no_f3:
end calminstruction
calminstruction rex p*,reg*,rm*,mem*
local rex
check(reg or rm)and 80h|mem and 2|p and 80000000000000h
jyes rex2_form
compute rex,40h
check p and 4000000h
jno rex_r
compute rex,rex or 48h
rex_r:
check reg and 8
jno rex_x
compute rex,rex or 44h
rex_x:
check mem
jno rex_b
compute rex,rex or 42h
rex_b:
check rm and 8
jno rex_store
compute rex,rex or 41h
rex_store:
check(reg or rm)and 80h
jyes upper
check(reg or rm)and 32
jyes high
emit 1,rex
exit
rex2_form:
check(reg or rm)and 32
jyes high
check p and 20000000000000h|((p shr 8)and 3)>=2
jyes upper
emit 1,0D5h
emit 1,((p shr 1)and 80h)or((reg and 80h)shr 1)or((mem and 2)shl 4)or((rm and 80h)shr 3)or((p shr 23)and 8)or((reg and 8)shr 1)or((mem and 1)shl 1)or((rm and 8)shr 3)
check(p shr 8)and 3
jno done
compute rex2,1
done:
exit
upper:
err 'registers 16-31 need REX2 or EVEX; this instruction has neither for these operands'
exit
high:
err 'ah, ch, dh and bh cannot be used with REX'
end calminstruction
calminstruction escape p*
check rex2
jyes rex2_map
emit 1,0Fh
check((p shr 8)and 3)=2
jno map3
emit 1,38h
map3:
check((p shr 8)and 3)=3
jno done
emit 1,3Ah
exit
rex2_map:
compute rex2,0
done:
end calminstruction
calminstruction immediate p*,imm*
local v
check p and 1000000000000h
jyes relative
check(p and 7000h)=1000h
jno not_8
emit 1,imm and 0FFh
exit
not_8:
check(p and 7000h)=3000h
jno not_32
compute v,imm
check v relativeto 0
jno dword_reloc
emit 4,v
exit
not_32:
check(p and 7000h)=2000h
jno not_16
compute v,imm
check v relativeto 0
jno word_reloc
emit 2,v and 0FFFFh
exit
not_16:
check(p and 7000h)=4000h
jno sign_extended
compute v,imm
check v relativeto 0
jno qword_reloc
emit 8,v
exit
sign_extended:
compute v,imm
check v relativeto 0
jno dword_reloc
check v>=8000000000000000h
jno imm32
compute v,v-10000000000000000h
imm32:
emit 4,v
exit
relative:
check(p and 7000h)=1000h
jno rel_wide
compute v,imm-($+1)
check v relativeto 0&v>=-80h&v<80h
jno out_of_range
emit 1,v and 0FFh
exit
rel_wide:
check(p and 7000h)=2000h
jno rel_32
compute v,imm-($+2)
check v relativeto 0
jno word_reloc
emit 2,v and 0FFFFh
exit
rel_32:
compute v,imm-($+4)
check mode=64&v relativeto 0&(v<-80000000h|v>=80000000h)
jyes out_of_range
check v relativeto 0
jno dword_reloc
emit 4,v and 0FFFFFFFFh
exit
out_of_range:
err 'jump out of range'
exit
word_reloc:
call word,v
exit
dword_reloc:
call dword,v
exit
qword_reloc:
call qword,v
end calminstruction
iterate slot,o1,o2,o3,mem
calminstruction store#% p*,reg*,imm*
check slot.kind=1
jno memory
check p and 0C6007006000300h|(reg or slot.rcode)and 98h
jyes reg_full
emit 1,p and 0FFh
emit 1,0C0h+((reg and 7)shl 3)+(slot.rcode and 7)
check p and 7000h
jno reg_done
check(p and 1000000007000h)=1000h
jno reg_imm
emit 1,imm and 0FFh
exit
reg_imm:
call immediate,p,imm
exit
reg_full:
check p and 46007000000000h
jyes reg_legacy
check p and 2000000h
jno reg_rex
emit 1,66h
jump reg_rex
reg_legacy:
call legacy,p
reg_rex:
check p and 4000000h|(reg or slot.rcode)and 98h
jno reg_escape
compute d,0
call rex,p,reg,slot.rcode,d
reg_escape:
check p and 300h
jno reg_opcode
call escape,p
reg_opcode:
emit 1,p and 0FFh
emit 1,0C0h+((reg and 7)shl 3)+(slot.rcode and 7)
check p and 7000h
jno reg_done
call immediate,p,imm
reg_done:
exit
memory:
check p and 0C6007006000300h|reg and 98h|slot.ea and 18000060008h|slot.seg
jno mem_opcode
check p and 0C6007000000300h|reg and 0A0h|slot.ea and 18000040000h|slot.seg
jyes mem_full
check p and 2000000h
jno fast_rex
emit 1,66h
fast_rex:
check p and 4000000h|reg and 18h|slot.ea and 20008h
jno mem_opcode
emit 1,40h or((p shr 23)and 8)or((reg and 8)shr 1)or((slot.ea shr 16)and 2)or((slot.ea and 8)shr 3)
jump mem_opcode
mem_full:
check p and 40000000000000h
jno no_wait
emit 1,9Bh
compute p,p and not 40000000000000h
no_wait:
check slot.seg
jno segment_ok
check slot.seg>4
jyes fs_gs
emit 1,26h+((slot.seg-1)shl 3)
jump segment_ok
fs_gs:
emit 1,64h+slot.seg-5
segment_ok:
check slot.ea and 40000h
jno asz_ok
emit 1,67h
asz_ok:
check p and 46007000000000h
jyes mem_legacy
check p and 2000000h
jno mem_rex
emit 1,66h
jump mem_rex
mem_legacy:
call legacy,p
mem_rex:
check p and 4000000h|reg and 98h|slot.ea and 18000020008h
jno mem_escape
compute rm,(slot.ea and 0Fh)or((slot.ea shr 32)and 80h)
compute d,((slot.ea shr 17)and 1)or((slot.ea shr 39)and 2)
call rex,p,reg,rm,d
mem_escape:
check p and 300h
jno mem_opcode
call escape,p
mem_opcode:
emit 1,p and 0FFh
emit 1,((slot.ea shr 22)and 0C0h)+((reg and 7)shl 3)+(slot.ea and 7)
check slot.ea and 10000h
jno sib_ok
emit 1,(slot.ea shr 8)and 0FFh
sib_ok:
check slot.ea and 1C0000000h
jno disp_ok
check slot.ea and 80000000h
jyes disp_2
check slot.ea and 40000000h
jno disp_4
emit 1,slot.disp and 0FFh
jump disp_ok
disp_2:
check slot.disp relativeto 0
jno disp_2_reloc
emit 2,slot.disp
jump disp_ok
disp_2_reloc:
call word,slot.disp
jump disp_ok
disp_4:
check slot.ea and 20000000000h
jyes rip
check slot.disp relativeto 0
jno disp_4_reloc
emit 4,slot.disp
jump disp_ok
disp_4_reloc:
call dword,slot.disp
jump disp_ok
rip:
compute rest,(p shr 12)and 7
compute d,0
check rest=1|rest=2
jno rip_4
compute d,rest
jump rip_emit
rip_4:
check rest=3|rest=5
jno rip_emit
compute d,4
rip_emit:
compute d,slot.disp-($+4+d)
check d relativeto 0
jno rip_reloc
emit 4,d
jump disp_ok
rip_reloc:
call dword,d
disp_ok:
check p and 7000h
jno mem_done
call immediate,p,imm
mem_done:
end calminstruction
end iterate
calminstruction storeo p*,reg*,imm*
local none
check p and 0C6007006000300h|reg and 98h
jyes full
emit 1,(p and 0FFh)+(reg and 7)
check p and 8000007000h
jno done
check(p and 1008000007000h)=1000h
jno suffix
emit 1,imm and 0FFh
