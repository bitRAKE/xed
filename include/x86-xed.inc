calminstruction x86.parse_operand#context operand
local pre,suf,t
compute size,0
match pre suf,operand
jno no_size
arrange t,pre
transform t,xed.size
jno no_size
match:t,t
jno no_size
compute size,t
arrange operand,suf
no_size:
match[t],operand
jyes memory
match =ptr? t,operand
jyes memory
compute type,'imm'
compute imm,+operand
check imm eq 1 elementof imm&1 metadataof imm relativeto xed.reg
jno done
compute t,1 metadataof imm-xed.reg
check t and 3000h
jyes segment
check((t shr 8)and 0Fh)-1<4
jno done
compute type,'reg'
compute size,1 shl(((t shr 8)and 0Fh)-1)
compute rm,(t and 0Fh)or((t and 80h)shr 3)
compute mod,3
exit
segment:
check(t and 3000h)=2000h
jno done
compute type,'sreg'
compute rm,t and 0Fh
compute mod,3
exit
memory:
compute type,'mem'
check size
jyes done
compute size,sizeof t
done:
end calminstruction
calminstruction SSE.parse_operand#context operand
local t
call x86.parse_operand#context,operand
check type='imm'&size=0
jno done
check imm eq 1 elementof imm&1 metadataof imm relativeto xed.reg
jno done
compute t,1 metadataof imm-xed.reg
check((t shr 8)and 0Fh)=5|((t shr 8)and 0Fh)=6
jno done
compute type,'mmreg'
compute size,8 shl(((t shr 8)and 0Fh)-5)
compute rm,(t and 0Fh)or((t and 80h)shr 3)
compute mod,3
done:
end calminstruction
end namespace
end iterate
