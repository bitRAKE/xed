check(w shr 59)and 3
jno regs_ok
check(vvvv and 1Fh)=4|(((rr and 0Fh)or((rr shr 3)and 10h))=4)
jyes no_rsp
check(w shr 59)and 1&(vvvv and 1Fh)=((rr and 0Fh)or((rr shr 3)and 10h))
jyes same_twice
regs_ok:
check sp=2|~(rx and 3Ah)
jyes prefix
