opcode:
check slot.kind=1
jno mem_opcode
emit 1,op
emit 1,0C0h or((reg and 7)shl 3)or(rr and 7)
jump immediate
mem_opcode:
emit 1,w and 0FFh
mem_modrm:
compute m,(slot.ea shr 28)and 3
compute ds,(slot.ea shr 30)and 7
compute d,slot.disp
check sp=2&(m=1|m=2)&d relativeto 0&~(slot.ea and 1000000000h)
jno disp_ready
compute n,1 shl((w shr 45)and 7)
check d>=0FFFFFF80h&d<100000000h
jno scale
compute d,d-100000000h
scale:
check d mod n=0&d/n>=-80h&d/n<80h
jno wide
compute m,1
compute ds,1
compute d,d/n
jump disp_ready
wide:
check slot.ea and 800000000h
jyes no_disp8
compute m,2
compute ds,4
check slot.ea and 2000000000h
jno disp_ready
compute ds,2
disp_ready:
