f4:
check f=4
jno f3
call storeo,w,k0,o1.imm
exit
f3:
check f=3
jno f0
call storeo,w,o1.rcode,k0
exit
f7:
check f=7
jno f8
compute d,(w shr 19)and 7
call store1,w,d,k0
exit
f8:
check f=8
jno f9
call storeo,w,o1.rcode,o2.imm
exit
f9:
check f=9
jno f10
call storeo,w,k0,o2.imm
exit
f10:
check f=10
jno f11
call store2,w,o1.rcode,o3.imm
exit
f11:
check f=11
jno f6
call store1,w,o2.rcode,o3.imm
exit
f6:
check f=6
jno f12
call storeo,w,k0,k0
exit
f12:
check f=12
jno f0
call storeo,w,o2.rcode,k0
exit
f0:
