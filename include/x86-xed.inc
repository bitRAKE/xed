calminstruction unhonoured
local w,d
check(req and REQ_KEY)=REQ_EVEX
jno other
compute d,(key*3+vslot)shl 4
load w,rows:d,16
check((w shr 51)and 3)=2|(((w shr 51)and 3)=1&(w shr 64)and 1)
