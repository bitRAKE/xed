jyes make_sib
emit 1,(m shl 6)or((reg and 7)shl 3)or(slot.ea and 7)
check slot.ea and 10000h
jno sib_ok
emit 1,(slot.ea shr 8)and 0FFh
jump sib_ok
make_sib:
check slot.ea and 22000000000h
jyes need_sib
emit 1,(m shl 6)or((reg and 7)shl 3)or 4
emit 1,20h or(slot.ea and 7)
sib_ok:
check ds
jno immediate
check ds=1
jno disp_2
emit 1,d and 0FFh
jump immediate
disp_2:
check ds=2
jno disp_4
check d relativeto 0
jno disp_2_reloc
emit 2,d
jump immediate
disp_2_reloc:
call word,d
jump immediate
disp_4:
check slot.ea and 20000000000h
jyes rip
check d relativeto 0
jno disp_4_reloc
emit 4,d
jump immediate
rip:
compute d,d-($+4+x)
check d relativeto 0
jno disp_4_reloc
emit 4,d
jump immediate
disp_4_reloc:
call dword,d
immediate:
check x=1
jno imm_4
emit 1,imm and 0FFh
jump done
imm_4:
check x=4
jno imm_2
compute imm,imm
check imm relativeto 0
jno imm_4_reloc
check imm>=8000000000000000h
jno imm_dword
compute imm,imm-10000000000000000h
imm_dword:
emit 4,imm
jump done
imm_4_reloc:
call dword,imm
jump done
imm_2:
check x=2
jno done
compute imm,imm
check imm relativeto 0
jno imm_2_reloc
emit 2,imm and 0FFFFh
jump done
imm_2_reloc:
call word,imm
jump done
high_byte:
err 'ah, ch, dh and bh cannot be used with EVEX'
exit
no_rsp:
err 'push2 and pop2 cannot take rsp'
exit
same_twice:
err 'pop2 needs two different registers'
exit
need_sib:
err 'this instruction needs a SIB address: not rip-relative, not 16-bit'
exit
no_vex2:
err '{vex2} cannot be honoured: these operands need the three-byte VEX'
exit
no_vex:
err '{vex2}/{vex3} cannot be honoured: these operands need EVEX'
exit
no_disp8:
err '{disp8} cannot be honoured: the displacement is not a multiple of the EVEX scale in range'
exit
no_zeroing:
err 'this instruction cannot zero ({z}): merging only'
exit
done:
check $-begin>15
jno short
err 'the instruction would be longer than 15 bytes'
short:
end calminstruction
end iterate
